{
    "custom/quicklink1": {
        "format": "  ",
        "on-click": "ghostty",
        "tooltip-format": "Terminal"
    }, 
    "custom/quicklink2": {
        "format": "  ",
        "on-click": "~/zen-browser/zen/zen",
        "tooltip-format": "Open the browser"
    },
    "custom/quicklink3": {
        "format": "  ",
        "on-click": "dolphin",
        "tooltip-format": "Open the filemanager"
    },
    "custom/quicklink4": {
        "format": " 🎵 ",
        "on-click": "~/.config/hypr/media-player/toggle.sh",
        "tooltip-format": "Open media player"
    },
    "group/quicklinks": {
        "orientation": "horizontal",
        "modules": [
            "custom/quicklink1",
            "custom/quicklink2",
            "custom/quicklink3",
            "custom/quicklink4"
        ]
    }
}
